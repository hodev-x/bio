{
  "name": "@bio/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && cp run.sh dist/run.sh && chmod +x dist/run.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "provision:secrets": "tsx scripts/provision-secrets.ts"
  },
  "dependencies": {
    "@bio/shared": "workspace:*",
    "@aws-sdk/client-dynamodb": "^3.660.0",
    "@aws-sdk/client-ssm": "^3.660.0",
    "@aws-sdk/lib-dynamodb": "^3.660.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "fastify": "^5.0.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
